{
  "name": "@iptrust/sdk",
  "version": "0.1.1",
  "description": "Official Node.js SDK for the IP Trust API: IP geolocation, ASN, company, hosting, bot, VPN, proxy and Tor detection.",
  "keywords": [
    "iptrust",
    "ip",
    "geolocation",
    "asn",
    "vpn",
    "proxy",
    "tor",
    "bot detection",
    "ip intelligence"
  ],
  "homepage": "https://iptrust.co",
  "bugs": "https://github.com/IP-Trust/iptrust-node/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IP-Trust/iptrust-node.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
